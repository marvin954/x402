# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=x402marketplace
POSTGRES_USER=x402admin
POSTGRES_PASSWORD=changeme_in_prod
DATABASE_URL=postgres://x402admin:changeme_in_prod@localhost:5432/x402marketplace

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
SERVER_URL=https://x402-lca0onkyr-marvin-stokes-projects.vercel.app

# ─── Platform Revenue ─────────────────────────────────────────────────────────
# Your MAMMBA wallet — receives 100% of every payment
PLATFORM_WALLET=0xYourBaseWalletAddress

# Platform fee percentage (e.g. 15 = 15%, providers earn 85%)
PLATFORM_FEE_PERCENT=15

# ─── x402 / Blockchain ────────────────────────────────────────────────────────
# Base Mainnet:
NETWORK=eip155:8453
USDC_ASSET=0x06c51D4732E14E0fACF9d6E6eE8c2755C098Aa35

FACILITATOR_URL=https://x402.xyz/facilitator
MAX_TIMEOUT_SECONDS=60

# ─── Security ─────────────────────────────────────────────────────────────────
# Random 64-char hex string — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_char_hex_secret_here
ADMIN_API_KEY=replace_with_admin_secret_key

# ─── Proxy ────────────────────────────────────────────────────────────────────
# Max response size to proxy (bytes) — 10MB default
MAX_PROXY_BODY=10485760
# Request timeout to upstream provider (ms)
PROXY_TIMEOUT_MS=15000

# ─── pgAdmin (dev only) ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@mammba.io
PGADMIN_PASSWORD=pgadmin_pass
# trigger redeploy
